generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  STUDENT
  TEACHER
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  name     String  @default("")
  role     Role
  active   Boolean @default(true)

  notifications Notification[]

  @@map("users")
}

model School {
  id       Int       @id @default(autoincrement())
  name     String
  students Student[]

  @@map("schools")

  @@index([name])
}

model Batch {
  id           Int           @id @default(autoincrement())
  classId      String        // "Six", "Seven", etc.
  name         String        // "8A", "9B", etc.
  code         Int           // 2-digit prefix: 61, 62, 71, etc.
  students     Student[]
  academicHistories StudentAcademicHistory[]
  programId    Int?
  program      Program?      @relation(fields: [programId], references: [id])
  specialExams       SpecialExam[]
  compiledMarksheets CompiledMarksheet[]
  routineSlots       RoutineSlot[]
  classSessions      ClassSession[]

  @@map("batches")

  @@index([classId])
}

model Student {
  id              Int                @id @default(autoincrement())
  name            String
  fatherName      String
  motherName      String
  mobile          String
  homeMobile      String             @default("")
  image           String             @default("")
  active          Boolean            @default(true)
  isArchived      Boolean            @default(false)
  archivedYear    Int?
  archivedReason  String?
  archivedAt      DateTime?
  schoolId        Int
  batchId         Int
  roll            Int                // Serial number within batch (1, 2, 3...)
  address         String
  gender          String
  email           String             @default("")
  dob             DateTime?
  class           String
  userId          Int?               @unique

  school          School             @relation(fields: [schoolId], references: [id])
  batch           Batch              @relation(fields: [batchId], references: [id])
  receipts        Receipt[]
  marks           Mark[]
  courseFees      StudentCourseFee[]
  studentSubjects StudentSubject[]
  specialMarks    SpecialMark[]
  academicHistories StudentAcademicHistory[]

  @@map("students")
  @@index([batchId])
  @@index([class])
  @@index([isArchived])
}

model Teacher {
  id              Int                  @id @default(autoincrement())
  name            String
  mobile          String               @unique
  image           String               @default("")
  gender          String
  email           String               @default("")
  perClass        Int                  @default(0)
  due             Int                  @default(0)
  userId          Int?                 @unique
  notifyEmail     Boolean              @default(true)
  whatsappNumber  String?

  classLogs       TeacherClassLog[]
  examSubjects    ExamSubject[]
  payments        TeacherPayment[]
  rates           TeacherRate[]
  specialSubjects SpecialExamSubject[]
  routineSlots    RoutineSlot[]
  classSessions   ClassSession[]
  notificationLogs NotificationLog[]

  @@map("teachers")
}

model Exam {
  id       Int           @id @default(autoincrement())
  type     String        // "Monthly", "Annual"
  month    String        // "Jan", "Feb", etc.
  year     Int           @default(2026)
  class    String        // "Six", "Seven", etc.
  subjects ExamSubject[]
  classSessions ClassSession[]

  @@map("exams")

  @@index([month])
  @@index([year, month])
}

model ExamSubject {
  id        Int      @id @default(autoincrement())
  examId    Int
  subject   String
  teacherId Int
  totalMark Int
  examDate  DateTime
  status    Int      @default(1)
  topics    String   @default("")

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])
  marks   Mark[]  @relation("ExamSubjectMarks")

  @@map("exam_subjects")
}

model Mark {
  id            Int     @id @default(autoincrement())
  examSubjectId Int
  studentId     Int
  written       Float   @default(0)
  objective     Float   @default(0)

  examSubject ExamSubject @relation("ExamSubjectMarks", fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examSubjectId, studentId])
  @@map("marks")
}

model Receipt {
  id        Int      @id @default(autoincrement())
  studentId Int
  month     String
  year      Int      @default(2026)
  amount    Int
  date      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@map("receipts")

  @@index([studentId])
  @@index([month])
  @@index([year, month])
}

model StudentAcademicHistory {
  id        Int      @id @default(autoincrement())
  studentId Int
  year      Int
  class     String
  batchId   Int
  roll      Int
  note      String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@unique([studentId, year])
  @@index([studentId])
  @@index([year, class])
  @@map("student_academic_histories")
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Int
  date        DateTime

  @@map("expenses")

  @@index([date])
}

model TeacherClassLog {
  id         Int            @id @default(autoincrement())
  teacherId  Int
  date       DateTime
  classes    Int            @default(0)
  month      String
  notebook   Int            @default(0)
  other      Int            @default(0)
  paid       Int            @default(0)
  perClass   Int            @default(0)
  source     String         @default("MANUAL") // MANUAL, AUTO
  dutyAmount Int            @default(0)
  autoKey    String?        @unique
  programId  Int?

  teacher    Teacher        @relation(fields: [teacherId], references: [id])
  program    Program?       @relation(fields: [programId], references: [id])
  sessions   ClassSession[]

  @@map("teacher_class_logs")

  @@index([teacherId])
  @@index([month])
  @@index([programId])
}

model TeacherPayment {
  id        Int      @id @default(autoincrement())
  teacherId Int
  month     String
  amount    Int
  date      DateTime @default(now())
  note      String   @default("")

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("teacher_payments")

  @@index([teacherId])
  @@index([month])
}

// -------------------------------------------------------------
// SPECIAL BATCH MODULE (SSC & JUNIOR SCHOOL)
// -------------------------------------------------------------

model Program {
  id           Int                @id @default(autoincrement())
  code         String             @unique // e.g. "SSC-2026", "JUNIOR-2026"
  name         String             // e.g. "SSC Special Batch 2026", "Junior School Special Batch 2026"
  category     String             // "SSC" | "JSC"
  year         Int                @default(2026)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  batches      Batch[]
  subjects     ProgramSubject[]
  courseFees   StudentCourseFee[]
  specialExams SpecialExam[]
  rates              TeacherRate[]
  compiledMarksheets CompiledMarksheet[]
  classSessions      ClassSession[]
  teacherClassLogs   TeacherClassLog[]

  @@map("programs")
}

model ProgramSubject {
  id                  Int                  @id @default(autoincrement())
  programId           Int
  name                String               // e.g. "Bangla 1st", "Physics", "Higher Math"
  code                String?              // e.g. "101", "126"
  isCombined          Boolean              @default(false)
  combinedGroupId     String?              // e.g. "BANGLA", "ENGLISH"
  isOptional          Boolean              @default(false)
  hasPractical        Boolean              @default(false)
  fullMarks           Float                @default(100)
  cqMax               Float                @default(70)
  mcqMax              Float                @default(30)
  practicalMax        Float                @default(0)
  writtenPass         Float?
  mcqPass             Float?
  practicalPass       Float?
  totalPass           Float?
  sortOrder           Int                  @default(0)

  program             Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  studentSubjects     StudentSubject[]
  specialExamSubjects SpecialExamSubject[]
  routineSlots        RoutineSlot[]
  classSessions       ClassSession[]

  @@map("program_subjects")
  @@index([programId])
}

model StudentSubject {
  id         Int            @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  isOptional Boolean        @default(false)

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    ProgramSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@map("student_subjects")
}

model StudentCourseFee {
  id         Int             @id @default(autoincrement())
  studentId  Int
  programId  Int
  agreedFee  Float?          // Reference agreed amount (no rigid unpaid ledger dues)
  notes      String          @default("")
  createdAt  DateTime        @default(now())

  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program    Program         @relation(fields: [programId], references: [id])
  payments   CoursePayment[]

  @@unique([studentId, programId])
  @@map("student_course_fees")
  @@index([studentId])
}

model CoursePayment {
  id                 Int              @id @default(autoincrement())
  studentCourseFeeId Int
  amount             Float
  paymentDate        DateTime         @default(now())
  receiptNo          String?          @unique
  paymentMethod      String           @default("CASH") // CASH, BKASH, NAGAD, BANK
  note               String           @default("")

  courseFee          StudentCourseFee @relation(fields: [studentCourseFeeId], references: [id], onDelete: Cascade)

  @@map("course_payments")
  @@index([paymentDate])
  @@index([studentCourseFeeId])
}

model SpecialExam {
  id           Int                     @id @default(autoincrement())
  programId    Int
  batchId      Int?
  title        String               // e.g. "Pre-Model Test 1", "Class Test - Chemistry Ch 3"
  kind         String               // "CLASS_TEST" | "PRE_MODEL" | "MODEL_TEST" | "BOARD_EXAM"
  lectureNo    Int?                 // e.g. 1, 2, ... 100 (for sequential sorting)
  lectureLabel String?              // e.g. "L-01", "Ch-03"
  examDate     DateTime
  status       String                  @default("SCHEDULED") // "SCHEDULED", "ONGOING", "COMPLETED", "PUBLISHED"
  createdAt    DateTime                @default(now())

  program      Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  batch        Batch?                  @relation(fields: [batchId], references: [id])
  subjects     SpecialExamSubject[]
  compilations CompiledMarksheetExam[]
  classSessions ClassSession[]

  @@map("special_exams")
  @@index([programId])
  @@index([kind])
  @@index([programId, lectureNo])
}

model SpecialExamSubject {
  id               Int            @id @default(autoincrement())
  examId           Int
  programSubjectId Int
  teacherId        Int?
  isCompulsory     Boolean        @default(true) // Defined by test creator (compulsory vs optional)
  cqMax            Float          @default(0)
  mcqMax           Float          @default(0)
  practicalMax     Float          @default(0)
  totalMax         Float          @default(100)
  examDate         DateTime?

  exam             SpecialExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  programSubject   ProgramSubject @relation(fields: [programSubjectId], references: [id])
  teacher          Teacher?       @relation(fields: [teacherId], references: [id])
  marks            SpecialMark[]

  @@map("special_exam_subjects")
  @@index([examId])
}

model SpecialMark {
  id                   Int                @id @default(autoincrement())
  specialExamSubjectId Int
  studentId            Int
  cq                   Float              @default(0)
  mcq                  Float              @default(0)
  practical            Float              @default(0)
  total                Float              @default(0)
  isAbsent             Boolean            @default(false)

  examSubject          SpecialExamSubject @relation(fields: [specialExamSubjectId], references: [id], onDelete: Cascade)
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([specialExamSubjectId, studentId])
  @@map("special_marks")
  @@index([studentId])
}

model TeacherRate {
  id          Int      @id @default(autoincrement())
  teacherId   Int
  programId   Int?
  lectureRate Float    @default(0)
  khataRate   Float    @default(0) // Evaluation rate per script

  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  program     Program? @relation(fields: [programId], references: [id])

  @@unique([teacherId, programId])
  @@map("teacher_rates")
}

model CompiledMarksheet {
  id          Int                     @id @default(autoincrement())
  programId   Int
  batchId     Int?                    // Nullable: if scoped to a specific section batch
  title       String                  // e.g. "Physics Lectures 01-10 Compilation"
  description String?                 @default("")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  createdBy   String?                 @default("")

  program     Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  batch       Batch?                  @relation(fields: [batchId], references: [id])
  exams       CompiledMarksheetExam[]

  @@index([programId])
  @@map("compiled_marksheets")
}

model CompiledMarksheetExam {
  id                  Int               @id @default(autoincrement())
  compiledMarksheetId Int
  specialExamId       Int
  sortOrder           Int               @default(0) // Order of appearance as columns

  compiledMarksheet   CompiledMarksheet @relation(fields: [compiledMarksheetId], references: [id], onDelete: Cascade)
  specialExam         SpecialExam       @relation(fields: [specialExamId], references: [id], onDelete: Cascade)

  @@unique([compiledMarksheetId, specialExamId])
  @@index([compiledMarksheetId])
  @@map("compiled_marksheet_exams")
}

// -------------------------------------------------------------
// CLASS ROUTINE, NOTIFICATIONS & AUTO CLASS LOGGING
// -------------------------------------------------------------

model ClassSession {
  id                Int                  @id @default(autoincrement())
  kind              String               @default("CLASS") // "CLASS" | "EXAM_DUTY" | "EXTRA"
  batchId           Int?
  programId         Int?
  subjectName       String               @default("")
  programSubjectId  Int?
  lectureLabel      String?              // e.g. "L-12", "Ch-04"
  teacherId         Int
  date              DateTime             @db.Date
  startTime         String               // "HH:mm" e.g. "16:00"
  endTime           String?              // "HH:mm" e.g. "17:30"
  room              String?
  examId            Int?
  specialExamId     Int?
  status            String               @default("SCHEDULED") // "SCHEDULED" | "CONDUCTED" | "CANCELLED" | "RESCHEDULED"
  payAmount         Float?               // For EXAM_DUTY
  routineSlotId     Int?
  originalSessionId Int?
  changeReason      String?
  countedLogId      Int?
  countedAt         DateTime?
  createdById       Int?
  updatedById       Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  batch             Batch?               @relation(fields: [batchId], references: [id])
  program           Program?             @relation(fields: [programId], references: [id])
  programSubject    ProgramSubject?      @relation(fields: [programSubjectId], references: [id])
  teacher           Teacher              @relation(fields: [teacherId], references: [id])
  exam              Exam?                @relation(fields: [examId], references: [id])
  specialExam       SpecialExam?         @relation(fields: [specialExamId], references: [id])
  routineSlot       RoutineSlot?         @relation(fields: [routineSlotId], references: [id])
  countedLog        TeacherClassLog?     @relation(fields: [countedLogId], references: [id])
  originalSession   ClassSession?        @relation("SessionRescheduleHistory", fields: [originalSessionId], references: [id])
  rescheduledSessions ClassSession[]     @relation("SessionRescheduleHistory")
  changeLogs        SessionChangeLog[]

  @@index([date])
  @@index([teacherId, date])
  @@index([batchId, date])
  @@index([status])
  @@map("class_sessions")
}

model RoutineSlot {
  id                Int                  @id @default(autoincrement())
  batchId           Int
  subjectName       String
  programSubjectId  Int?
  teacherId         Int
  weekday           Int                  // 0 = Sun, 1 = Mon ... 6 = Sat
  startTime         String               // "HH:mm"
  endTime           String?
  room              String?
  validFrom         DateTime             @db.Date
  validTo           DateTime?            @db.Date
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  batch             Batch                @relation(fields: [batchId], references: [id])
  programSubject    ProgramSubject?      @relation(fields: [programSubjectId], references: [id])
  teacher           Teacher              @relation(fields: [teacherId], references: [id])
  sessions          ClassSession[]

  @@index([batchId, weekday])
  @@index([teacherId, weekday])
  @@map("routine_slots")
}

model SessionChangeLog {
  id                Int                  @id @default(autoincrement())
  sessionId         Int
  action            String               // CREATE, UPDATE, REASSIGN, RESCHEDULE, CANCEL, ADJUST, COUNT
  before            Json?
  after             Json?
  reason            String?
  byUserId          Int?
  byUsername        String?
  createdAt         DateTime             @default(now())

  session           ClassSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("session_change_logs")
}

model Notification {
  id                Int                  @id @default(autoincrement())
  userId            Int
  kind              String               // SCHEDULE_CHANGE, CANCEL, RESCHEDULE, ASSIGN, ANNOUNCEMENT
  title             String
  body              String
  href              String?
  sessionId         Int?
  dedupeKey         String?              @unique
  createdAt         DateTime             @default(now())
  readAt            DateTime?

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id                Int                  @id @default(autoincrement())
  teacherId         Int
  channel           String               // EMAIL, IN_APP, WHATSAPP_LINK
  kind              String               // DAILY_DIGEST, ASSIGN, CHANGE, CANCEL
  forDate           String               // YYYY-MM-DD
  status            String               @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  recipient         String?
  providerMessageId String?
  error             String?
  attempts          Int                  @default(1)
  sentAt            DateTime?
  dedupeKey         String?              @unique
  createdAt         DateTime             @default(now())

  teacher           Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, forDate])
  @@index([status])
  @@map("notification_logs")
}

model JobRun {
  id                Int                  @id @default(autoincrement())
  job               String               // DAILY_DIGEST, DAY_CLOSE, PLANNING_REMINDER
  forDate           String               // YYYY-MM-DD
  startedAt         DateTime             @default(now())
  finishedAt        DateTime?
  status            String               // SUCCESS, FAILED, RUNNING
  summary           Json?
  error             String?

  @@index([job, forDate])
  @@map("job_runs")
}